Thumbs.db

# Word and Excel lock files. Created while a document is open and deleted on close, so one
# committed by accident is a file that will never exist again on anyone else's machine.
~$*

# Tooling scratch dirs
.claude/

# Smoke tests & efficiency ablations
smoke-test*/
smoke-l4*/
ablation-*/
ab-*/
ablation_results.json

# Temporary verification clone created by verify_github.bat
test_clone/
verify_clone/

# Training artefacts downloaded from the model repository for verification.
# They are already published at huggingface.co/hosseinzr/neyshekar-whisper-large-v3-lora,
# and collect_run_facts.py reads them straight from there, so there is no reason to carry
# a 630 KB log in the repository as well.
run_artifacts/

# test_clips/ is deliberately NOT ignored. The five demo clips are committed so demo.html
# works for anyone who opens the published page without downloading 7.3 GB of corpus first.
# The dataset is CC0-1.0, so redistributing five clips carries no licence question.

# The hand-styled copies of the documents. Same content as docs/, different typeface and a
# cover image; two sets of the same five files on one page only raises "which do I read".
docs/MY EDITED DOCS/
